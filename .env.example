RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=admin
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_REGION=us-east-1
S3_BUCKET=hh-lake
S3_INPUT_KEY=it_vacancies_2024.csv
S3_OUTPUT_PREFIX=results/
CHUNK_SIZE=1000
MAX_IN_FLIGHT=2
LOG_LEVEL=INFO

S3_INTERMEDIATE_PREFIX=intermediate/

# Must exceed the longest task duration; affects recovery after a killed worker.
CELERY_VISIBILITY_TIMEOUT=120
